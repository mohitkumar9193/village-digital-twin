DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=https://YOUR-PROJECT.vercel.app
VILLAGE_ID=copy-the-id-printed-by-bootstrap-neon
CRON_SECRET=replace-with-another-random-secret-of-at-least-32-characters
NODE_ENV=production
# Only for the one-time local bootstrap; do not add these to Vercel:
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
