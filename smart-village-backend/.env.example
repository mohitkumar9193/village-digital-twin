NODE_ENV=development
PORT=4000
# Transactions require Atlas or a local replica set, not standalone MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_village?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=smart-village-api
JWT_AUDIENCE=smart-village-web
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=data/uploads
# Set after running npm run bootstrap
VILLAGE_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
VILLAGE_NAME=

# Optional private Python priority assistant
AI_SERVICE_URL=http://127.0.0.1:8001
# Set the same random 32+ character secret on Python and Node; never ship it in frontend code.
# AI_SERVICE_KEY=
